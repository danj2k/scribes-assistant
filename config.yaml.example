# Scribe's Assistant — Configuration
# All settings have sensible defaults. Only override what you need.

# Discord bot settings
discord:
  # Numeric Snowflake ID (17-20 digits) to restrict bot to this server only
  # Leave empty to allow any server. To find it: enable Developer Mode in
  # Discord (User Settings > Advanced), then right-click your server > Copy Server ID
  # https://discord.com/developers/docs/reference#snowflakes
  guild_id: ""
    # Numeric Snowflake ID for the channel where transcripts are delivered
  # Leave empty to use the channel where /session was used
  transcript_channel_id: ""

  # Command permissions
  permissions:
    # Restrict command usage to specific roles (default: false = everyone can use)
    restrict_commands: false
    # List of role names or IDs allowed when restrict_commands is true
    allowed_roles: []

# Lexicon settings
lexicon:
  # Enable/disable lexicon features (add/remove/list commands)
  enabled: true
  # Levenshtein distance threshold for fuzzy post-correction matching
  # Lower = stricter matching, higher = more permissive
  # 0.0 = exact match only, 1.0 = match almost anything
  # Recommended starting point: 0.2
  fuzzy_threshold: 0.2
  # Path to lexicon file (relative to /data in the container)
  file: /data/lexicon.yaml

# Session settings
session:
  # Seconds of silence before auto-ending a session when bot is alone in voice channel
  idle_timeout: 60

# Transcriber settings
transcriber:
  # Seconds between queue polling cycles
  poll_interval: 10
  # Number of CPU threads for sherpa-onnx (0 = use all available cores)
  # Set to match your available cores minus 1 (e.g. 3 for a 4-core machine)
  threads: 0
  # Whisper model size: tiny, base, small, medium, large-v3
  model: small

# Logging
logging:
  # Log level: DEBUG, INFO, WARNING, ERROR
  level: INFO
  # Maximum log file size in MB before rotation
  max_size_mb: 10
  # Number of rotated log files to keep
  backup_count: 5
