# Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# Channel IDs for transcript delivery (required)
ANNOUNCEMENT_CHANNEL_ID=123456789012345678
TRANSCRIPT_CHANNEL_ID=123456789012345678

# Database path (default: /app/data/transcriptions.db)
DATABASE_PATH=/app/data/transcriptions.db

# Log level (default: INFO)
LOG_LEVEL=INFO

# Log file path (default: /app/data/logs/bot.log)
LOG_FILE=/app/data/logs/bot.log
